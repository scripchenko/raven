<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>UnifiedMessenger.App</AssemblyName>
    <RootNamespace>UnifiedMessenger.App</RootNamespace>
    <ApplicationIcon>Assets\Branding\lantern_system.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>raven</Product>
    <Title>raven</Title>
    <AssemblyTitle>raven</AssemblyTitle>
    <Description>Windows-приложение для мессенджеров и почты.</Description>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Branding\lantern_system.ico" />
    <Resource Include="Assets\Branding\lantern_sidebar.png" />
    <Resource Include="Assets\Branding\raven_icon.png" />
    <Resource Include="Assets\Branding\raven_logo.png" />
    <Resource Include="Assets\Branding\raven_system.png" />
    <Resource Include="Assets\Branding\raven_tile.png" />
    <Resource Include="Assets\Services\*.png" />
    <Content Include="Assets\Sounds\lantern_notification.wav"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.75.0.4225" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <Target Name="ExcludeDistributionDocumentationFiles"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishProfile)' == 'win-x64-self-contained'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.xml'" />
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\Assets\Branding\raven.ico">
        <RelativePath>Assets\Branding\raven.ico</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\Assets\Branding\raven_desktop.ico">
        <RelativePath>Assets\Branding\raven_desktop.ico</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\Assets\Branding\lantern_system.ico">
        <RelativePath>Assets\Branding\lantern_system.ico</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
