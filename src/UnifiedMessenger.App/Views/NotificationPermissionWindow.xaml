<Window x:Class="UnifiedMessenger.App.Views.NotificationPermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разрешение уведомлений"
        Width="440"
        Height="210"
        MinWidth="440"
        MinHeight="210"
        MaxWidth="440"
        MaxHeight="210"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   VerticalAlignment="Center"
                   FontSize="16"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button Width="120"
                    Margin="0,0,10,0"
                    Click="Allow_Click"
                    Content="Разрешить"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Width="120"
                    Click="Deny_Click"
                    Content="Запретить"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
