<Window x:Class="UnifiedMessenger.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:UnifiedMessenger.App.Converters"
        xmlns:views="clr-namespace:UnifiedMessenger.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="760"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="M"
                    Modifiers="Control+Shift"
                    Command="{Binding ToggleDoNotDisturbCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ServiceGlyphConverter x:Key="ServiceGlyphConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="48" Height="48" Background="{DynamicResource AccentBrush}" CornerRadius="14">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="U" />
                </Border>

                <ListBox x:Name="AccountsList"
                         Grid.Row="1"
                         Margin="0,14"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ServiceTile"
                                    Width="48"
                                    Height="48"
                                    Background="{DynamicResource SidebarHoverBrush}"
                                    CornerRadius="14"
                                    ToolTip="{Binding DisplayName}">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Переименовать" CommandParameter="{Binding}" Click="RenameAccount_Click" />
                                        <MenuItem Header="Включить / отключить" CommandParameter="{Binding}" Click="ToggleAccount_Click" />
                                        <Separator />
                                        <MenuItem Header="Переместить выше" CommandParameter="{Binding}" IsEnabled="{Binding IsWebService}" Click="MoveAccountUp_Click" />
                                        <MenuItem Header="Переместить ниже" CommandParameter="{Binding}" IsEnabled="{Binding IsWebService}" Click="MoveAccountDown_Click" />
                                        <Separator />
                                        <MenuItem Header="Удалить…" CommandParameter="{Binding}" Click="DeleteAccount_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="{Binding Glyph}" />
                                    <Border MinWidth="20"
                                            Height="18"
                                            Padding="4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#E53935"
                                            CornerRadius="9"
                                            Visibility="{Binding ShowUnreadBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Text="{Binding UnreadBadgeText}" />
                                    </Border>
                                    <Ellipse Width="10"
                                             Height="10"
                                             Margin="0,0,1,1"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Fill="#E53935"
                                             Stroke="White"
                                             StrokeThickness="2"
                                             Visibility="{Binding ShowUnreadDot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ServiceTile" Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="ServiceTile" Property="Opacity" Value="0.42" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                            ToolTip="Добавить сервис"
                            Click="AddService_Click"
                            Content="+" />
                    <Button AutomationProperties.AutomationId="OpenSettingsButton"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource SidebarActionButtonStyle}"
                            ToolTip="Настройки"
                            Content="⚙" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="ServiceWorkspace">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Command="{Binding GoBackCommand}"
                                Content="←"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Назад" />
                        <Button Command="{Binding GoForwardCommand}"
                                Content="→"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Вперёд" />
                        <Button Command="{Binding ReloadCommand}"
                                Content="↻"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Обновить" />
                        <Button Command="{Binding NavigateHomeCommand}"
                                Content="⌂"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Домой" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedAccountDisplayName}" />
                        <ProgressBar Height="2"
                                     Margin="0,6,0,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Margin="0,0,10,0"
                                Command="{Binding ToggleSelectedMuteCommand}"
                                Content="{Binding MuteButtonText}"
                                IsEnabled="{Binding HasSelectedService}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="{Binding MuteButtonToolTip}" />
                        <Border Padding="10,5"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="10"
                                ToolTip="{Binding WebViewRuntimeVersion, StringFormat=WebView2 Runtime {0}}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}" Text="{Binding SelectedAccountLabel}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

                <Grid Grid.Row="1" Background="White">
                <views:WelcomeView>
                    <views:WelcomeView.Style>
                        <Style TargetType="views:WelcomeView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:WelcomeView.Style>
                </views:WelcomeView>

                <Grid x:Name="WebViewContainer"
                      Background="White"
                      Visibility="{Binding HasActiveWebView, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:MailInboxView x:Name="MailInboxContent" />

                <Border Margin="36"
                        Padding="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding IsSelectedMailAccountDisabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="560">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="Почтовый аккаунт отключён" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Учётные данные сохранены. Включить аккаунт можно в разделе Настройки → Аккаунты."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#EFFFFFFF"
                        Visibility="{Binding IsWebViewInitializing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,18,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Подготовка отдельного защищённого профиля WebView2…" />
                    </StackPanel>
                </Border>

                <Border Margin="36"
                        Padding="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding IsSelectedServiceDisabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="560">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="Аккаунт отключён" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Профиль и авторизация сохранены. Включите аккаунт, чтобы продолжить с тем же профилем."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,24,0,0"
                                HorizontalAlignment="Center"
                                Click="EnableSelectedAccount_Click"
                                Content="Включить"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="36"
                        Padding="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding HasWebViewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="560">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding WebViewErrorTitle}" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding WebViewErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding WebViewErrorCode}" />
                        <Button Margin="0,24,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding RetryCommand}"
                                Content="Повторить"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <views:SettingsView x:Name="SettingsContent" />
            </Border>
        </Grid>
    </Grid>
</Window>
