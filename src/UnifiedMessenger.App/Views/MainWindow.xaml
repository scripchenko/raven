<Window x:Class="UnifiedMessenger.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:UnifiedMessenger.App.Converters"
        xmlns:views="clr-namespace:UnifiedMessenger.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="760"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ServiceGlyphConverter x:Key="ServiceGlyphConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="48" Height="48" Background="{DynamicResource AccentBrush}" CornerRadius="14">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="U" />
                </Border>

                <ListBox Grid.Row="1"
                         Margin="0,14"
                         ItemsSource="{Binding Services}"
                         SelectedItem="{Binding SelectedService}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ServiceTile"
                                    Width="48"
                                    Height="48"
                                    Background="{DynamicResource SidebarHoverBrush}"
                                    CornerRadius="14"
                                    ToolTip="{Binding DisplayName}">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="{Binding ServiceType, Converter={StaticResource ServiceGlyphConverter}}" />
                                    <Border Width="10"
                                            Height="10"
                                            Margin="0,0,-2,-2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="#FFFF5D68"
                                            BorderBrush="{DynamicResource SidebarBrush}"
                                            BorderThickness="2"
                                            CornerRadius="5"
                                            Visibility="{Binding HasUnreadActivity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ServiceTile" Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Button IsEnabled="False"
                            Style="{StaticResource SidebarActionButtonStyle}"
                            ToolTip="Добавление сервисов появится на этапе 3"
                            Content="+" />
                    <Button IsEnabled="False"
                            Style="{StaticResource SidebarActionButtonStyle}"
                            ToolTip="Настройки появятся на этапе 6"
                            Content="⚙" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Command="{Binding GoBackCommand}"
                                Content="←"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Назад" />
                        <Button Command="{Binding GoForwardCommand}"
                                Content="→"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Вперёд" />
                        <Button Command="{Binding ReloadCommand}"
                                Content="↻"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Обновить" />
                        <Button Command="{Binding NavigateHomeCommand}"
                                Content="⌂"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="Домой" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedService.DisplayName, TargetNullValue=UnifiedMessenger}" />
                        <ProgressBar Height="2"
                                     Margin="0,6,0,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="10,5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="10"
                            ToolTip="{Binding WebViewRuntimeVersion, StringFormat=WebView2 Runtime {0}}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}" Text="Telegram · WebView2" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="White">
                <views:WelcomeView>
                    <views:WelcomeView.Style>
                        <Style TargetType="views:WelcomeView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:WelcomeView.Style>
                </views:WelcomeView>

                <Grid x:Name="WebViewContainer"
                      Background="White"
                      Visibility="{Binding HasSelectedService, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Background="#EFFFFFFF"
                        Visibility="{Binding IsWebViewInitializing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,18,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Подготовка защищённого профиля Telegram…" />
                    </StackPanel>
                </Border>

                <Border Margin="36"
                        Padding="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding HasWebViewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="560">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding WebViewErrorTitle}" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding WebViewErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding WebViewErrorCode}" />
                        <Button Margin="0,24,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding RetryCommand}"
                                Content="Повторить"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
