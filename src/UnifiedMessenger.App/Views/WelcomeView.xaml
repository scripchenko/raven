<UserControl x:Class="UnifiedMessenger.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="960">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="48">
            <Border MaxWidth="820"
                    Padding="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="24">
                <StackPanel>
                    <Border Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="20">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="U" />
                    </Border>

                    <TextBlock Margin="0,24,0,8"
                               HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Text="Добро пожаловать в UnifiedMessenger" />
                    <TextBlock MaxWidth="620"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Лёгкое единое окно для мессенджеров и почты. На этапе 2 подключён один официальный Telegram WebView2 с отдельным сохраняемым профилем."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <ItemsControl Margin="0,32,0,0" ItemsSource="{Binding AvailableServices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="126"
                                        Margin="6"
                                        Padding="12"
                                        Background="{DynamicResource WindowBackgroundBrush}"
                                        CornerRadius="14">
                                    <StackPanel>
                                        <Border Width="38"
                                                Height="38"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="11">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding Glyph}" />
                                        </Border>
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,30,0,0"
                            Padding="16,12"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="12">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Этап 2 · Telegram, навигация и обработка ошибок"
                                   TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
