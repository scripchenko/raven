<UserControl x:Class="UnifiedMessenger.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:UnifiedMessenger.App.Services.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AutomationProperties.AutomationId="WelcomeView"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="960">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,48,32,36">
            <Border MaxWidth="680"
                    Padding="36"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="{loc:Text Key='Welcome to raven'}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,28"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{loc:Text Key='Messaging and email in one place.'}"
                               TextWrapping="Wrap" />

                    <Border Padding="18,15"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{loc:Text Key='Messengers'}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Text Key='Telegram · WhatsApp · MAX · VK'}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="18,15"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{loc:Text Key='Email'}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Text Key='Gmail · Yandex Mail · Mail.ru · IMAP'}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,28,0,0"
                               Text="{loc:Text Key='Add your accounts in Settings to get started.'}"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,20,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap">
                        <Run Text="{loc:Text Key='Need help?'}" />
                        <Run Text=" " />
                        <Hyperlink NavigateUri="https://t.me/dscripchenko"
                                   RequestNavigate="Support_RequestNavigate"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Cursor="Hand">@dscripchenko</Hyperlink>
                    </TextBlock>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
