<Window x:Class="UnifiedMessenger.App.Views.AddServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:UnifiedMessenger.App.Services.Localization"
        Title="{loc:Text Key='Add service'}"
        Width="460"
        Height="430"
        MinWidth="420"
        MinHeight="390"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Text Key='Add service'}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{loc:Text Key='Choose a service. Each account gets a separate protected WebView2 profile.'}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListBox x:Name="ServiceList"
                 Grid.Row="1"
                 Margin="0,22,0,18"
                 BorderThickness="0"
                 SelectionChanged="ServiceList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card"
                                        Padding="14,11"
                                        Background="{DynamicResource WindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="42" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="{Binding Glyph}" />
                        <TextBlock Text="{Binding DisplayName}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2">
            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="{loc:Text Key='Account name'}" />
            <TextBox x:Name="AccountNameTextBox"
                     Height="40"
                     Padding="10,7"
                     MaxLength="80"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="96" Height="40" Margin="0,0,10,0" Click="Cancel_Click" Content="{loc:Text Key='Cancel'}" IsCancel="True" />
            <Button Width="112" Height="40" Click="Add_Click" Content="{loc:Text Key='Add'}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
