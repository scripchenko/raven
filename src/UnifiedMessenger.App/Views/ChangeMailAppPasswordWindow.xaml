<Window x:Class="UnifiedMessenger.App.Views.ChangeMailAppPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:UnifiedMessenger.App.Services.Localization"
        Title="{loc:Text Key='Change app password'}"
        Width="500"
        Height="340"
        MinWidth="460"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="23"
                       FontWeight="SemiBold"
                       Text="{loc:Text Key='Change app password'}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding PasswordGuidance}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,18">
            <TextBlock FontWeight="SemiBold" Text="{loc:Text Key='Account'}" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding EmailAddress}" />
            <TextBlock Margin="0,18,0,0"
                       FontWeight="SemiBold"
                       Text="{loc:Text Key='New app password'}" />
            <PasswordBox x:Name="PasswordBox"
                         Margin="0,7,0,0"
                         AutomationProperties.Name="{loc:Text Key='New app password'}" />
            <TextBlock x:Name="StatusText"
                       Margin="0,12,0,0"
                       Foreground="#B3261E"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="105"
                    Click="Cancel_Click"
                    Content="{loc:Text Key='Cancel'}"
                    IsCancel="True" />
            <Button x:Name="SaveButton"
                    Width="180"
                    Margin="10,0,0,0"
                    Click="Save_Click"
                    Content="{loc:Text Key='Check and save'}"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
