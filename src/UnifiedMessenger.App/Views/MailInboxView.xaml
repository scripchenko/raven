<UserControl x:Class="UnifiedMessenger.App.Views.MailInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UnifiedMessenger.App.Models"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Geometry x:Key="MailFolderInboxGeometry">M2,3 L16,3 16,15 2,15 Z M2,10 L6,10 7.5,12 10.5,12 12,10 16,10</Geometry>
        <Geometry x:Key="MailFolderStarredGeometry">M9,1.8 L11.2,6.2 16.1,6.9 12.5,10.4 13.4,15.3 9,13 4.6,15.3 5.5,10.4 1.9,6.9 6.8,6.2 Z</Geometry>
        <Geometry x:Key="MailFolderSentGeometry">M2,9 L16,2 11,16 8,10 Z M8,10 L16,2</Geometry>
        <Geometry x:Key="MailFolderDraftGeometry">M4,2 L11,2 15,6 15,16 4,16 Z M11,2 L11,6 15,6 M7,9 L12,9 M7,12 L12,12</Geometry>
        <Geometry x:Key="MailFolderSpamGeometry">M9,2 L17,16 1,16 Z M9,7 L9,11 M9,13 L9,14</Geometry>
        <Geometry x:Key="MailFolderTrashGeometry">M4,5 L14,5 13,16 5,16 Z M3,5 L15,5 M6,5 L6,3 12,3 12,5 M7,8 L7,13 M11,8 L11,13</Geometry>
        <Geometry x:Key="MailActionArchiveGeometry">M4,5 L20,5 L20,9 L4,9 Z M6,9 L6,20 L18,20 L18,9 M12,11 L12,17 M9,14 L12,17 L15,14</Geometry>
        <Geometry x:Key="MailActionTrashGeometry">M4,7 L20,7 M9,4 L15,4 L16,7 M7,7 L8,20 L16,20 L17,7 M10,10 L10.5,17 M14,10 L13.5,17</Geometry>
        <Geometry x:Key="MailActionMarkReadGeometry">M3.5,10 L12,4 L20.5,10 L20.5,19.5 L3.5,19.5 Z M4,10 L12,16 L20,10</Geometry>
        <Geometry x:Key="MailActionMarkUnreadGeometry">M3.5,6.5 L20.5,6.5 L20.5,17.5 L3.5,17.5 Z M4,7 L12,13 L20,7</Geometry>
        <Geometry x:Key="MailActionLabelGeometry">M4,5 L13,5 L20,12 L12,20 L4,12 Z M8,9 L8.1,9</Geometry>
        <Geometry x:Key="MailActionClearSelectionGeometry">M6,6 L18,18 M18,6 L6,18</Geometry>
        <Geometry x:Key="MailActionRefreshGeometry">M20,4 L20,10 L14,10 M20,10 A8,8 0 0 0 6.3,5.3 M4,20 L4,14 L10,14 M4,14 A8,8 0 0 0 17.7,18.7</Geometry>
        <Geometry x:Key="MailSearchGeometry">M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 M15.5,15.5 L21,21</Geometry>

        <Style x:Key="MailFolderItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FolderBackground"
                                Padding="12,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FolderBackground" Property="Background" Value="#FFEAF2FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FolderBackground" Property="Background" Value="Transparent" />
                                <Setter TargetName="FolderBackground" Property="BorderBrush" Value="#FF2356B8" />
                                <Setter TargetName="FolderBackground" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#FF2356B8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailMessageButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MessageButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MessageButtonBackground" Property="Background" Value="#FFF4F6F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MessageButtonBackground" Property="Background" Value="#FFE2ECFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailSecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="#FFF3F6FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailDetailToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Foreground" Value="#FF34445A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToolbarButtonBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolbarButtonBackground" Property="Background" Value="#FFF0F3F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolbarButtonBackground" Property="Background" Value="#FFE2E8F0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToolbarButtonBackground" Property="BorderBrush" Value="#FF2D7DFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailToolbarIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="Both" />
        </Style>

        <Style x:Key="MailActionToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Foreground" Value="#FF34445A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBackground" Property="Background" Value="#FFF0F3F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailComposeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#FF245BB5" />
            <Setter Property="Background" Value="#FFE7F0FF" />
            <Setter Property="BorderBrush" Value="#FFD5E3F8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ComposeBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <StackPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Path Width="18"
                                      Height="18"
                                      Margin="0,0,10,0"
                                      Data="M3,14 L4,10 12,2 16,6 8,14 Z M10,4 L14,8"
                                      Fill="Transparent"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.6" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComposeBorder" Property="Background" Value="#FFDCEAFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ComposeBorder" Property="Background" Value="#FFCFE1FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="MailNavigationPanel"
                Grid.Column="0"
                Padding="14,18"
                Background="#FFF8FAFC">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                        HorizontalAlignment="Stretch"
                        Command="{Binding Compose.NewMessageCommand}"
                        Content="Написать"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{StaticResource MailComposeButtonStyle}" />

                <ListBox Grid.Row="1"
                         Margin="0,16,0,0"
                         ItemsSource="{Binding Folders}"
                         SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource MailFolderItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="FolderIcon"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource MailFolderInboxGeometry}"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.4"
                                      Stretch="Uniform" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MailFolderKind.Sent}">
                                    <Setter TargetName="FolderIcon" Property="Data" Value="{StaticResource MailFolderSentGeometry}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MailFolderKind.Starred}">
                                    <Setter TargetName="FolderIcon" Property="Data" Value="{StaticResource MailFolderStarredGeometry}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MailFolderKind.Drafts}">
                                    <Setter TargetName="FolderIcon" Property="Data" Value="{StaticResource MailFolderDraftGeometry}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MailFolderKind.Spam}">
                                    <Setter TargetName="FolderIcon" Property="Data" Value="{StaticResource MailFolderSpamGeometry}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MailFolderKind.Trash}">
                                    <Setter TargetName="FolderIcon" Property="Data" Value="{StaticResource MailFolderTrashGeometry}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

        <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,10"
                    Background="White"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding IsSearchAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="560" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Height="40"
                            Background="#FFF3F6FA"
                            BorderBrush="#FFD9E1EC"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Выполнить поиск"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource MailActionToolbarButtonStyle}"
                                    ToolTip="Выполнить поиск">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource MailSearchGeometry}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeThickness="1.7" />
                                </Viewbox>
                            </Button>
                            <TextBox x:Name="MailSearchTextBox"
                                     Grid.Column="1"
                                     Padding="2,0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Поиск в почте"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14.5"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                                </TextBox.InputBindings>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="ToolTip" Value="Поиск в почте" />
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Grid.Column="1"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="#FF78879A"
                                       Text="Поиск в почте">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Очистить поиск"
                                    Command="{Binding ClearSearchCommand}"
                                    Content="×"
                                    FontSize="20"
                                    Style="{StaticResource MailActionToolbarButtonStyle}"
                                    ToolTip="Очистить поиск"
                                    Visibility="{Binding CanClearSearch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="MessageListSurface"
                  Grid.Row="1"
                  Visibility="{Binding IsMessageListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="18,0"
                        Background="White"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <CheckBox Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Выбрать все загруженные письма"
                                  Command="{Binding SelectAllLoadedCommand}"
                                  IsChecked="{Binding LoadedSelectionState, Mode=OneWay}"
                                  IsThreeState="True"
                                  ToolTip="Выбрать все загруженные письма"
                                  Visibility="{Binding IsGmailMailboxAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,4,0"
                                AutomationProperties.Name="Обновить"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Обновить">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource MailActionRefreshGeometry}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <StackPanel x:Name="MailPaginationPanel"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsPageNavigationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding PageRangeText}" />
                            <Button Width="32"
                                    Height="32"
                                    Margin="0,0,2,0"
                                    AutomationProperties.Name="Предыдущая страница"
                                    Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource MailActionToolbarButtonStyle}"
                                    ToolTip="Предыдущая страница">
                                <TextBlock FontSize="22" Text="‹">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="-3" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <Button Width="32"
                                    Height="32"
                                    AutomationProperties.Name="Следующая страница"
                                    Command="{Binding NextPageCommand}"
                                    Style="{StaticResource MailActionToolbarButtonStyle}"
                                    ToolTip="Следующая страница">
                                <TextBlock FontSize="22" Text="›">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="-3" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasSelectedMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Margin="4,0,0,0"
                                    AutomationProperties.Name="Архивировать"
                                    Command="{Binding ArchiveSelectedCommand}"
                                    Style="{StaticResource MailDetailToolbarButtonStyle}"
                                    ToolTip="Архивировать">
                                <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource MailActionArchiveGeometry}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.6" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    AutomationProperties.Name="Удалить"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Style="{StaticResource MailDetailToolbarButtonStyle}"
                                    ToolTip="Удалить">
                                <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource MailActionTrashGeometry}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.6" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    AutomationProperties.Name="Пометить как прочитанное"
                                    Command="{Binding MarkSelectedReadCommand}"
                                    Style="{StaticResource MailDetailToolbarButtonStyle}"
                                    ToolTip="Пометить как прочитанное">
                                <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource MailActionMarkReadGeometry}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.65" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    AutomationProperties.Name="Пометить как непрочитанное"
                                    Command="{Binding MarkSelectedUnreadCommand}"
                                    Style="{StaticResource MailDetailToolbarButtonStyle}"
                                    ToolTip="Пометить как непрочитанное">
                                <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource MailActionMarkUnreadGeometry}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.65" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    AutomationProperties.Name="{Binding SelectedStarActionText}"
                                    Command="{Binding ToggleSelectedStarCommand}"
                                    FontSize="20"
                                    Style="{StaticResource MailDetailToolbarButtonStyle}"
                                    ToolTip="{Binding SelectedStarActionText}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="☆" />
                                            <Setter Property="Foreground" Value="#FF6B7280" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AreAllSelectedMessagesStarred}" Value="True">
                                                    <Setter Property="Text" Value="★" />
                                                    <Setter Property="Foreground" Value="#FFF4B400" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    AutomationProperties.Name="Ярлыки"
                                    Command="{Binding OpenLabelsForSelectionCommand}"
                                    Style="{StaticResource MailDetailToolbarButtonStyle}"
                                    ToolTip="Ярлыки">
                                <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource MailActionLabelGeometry}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.7" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    AutomationProperties.Name="Снять выделение"
                                    Command="{Binding ClearSelectionCommand}"
                                    Style="{StaticResource MailDetailToolbarButtonStyle}"
                                    ToolTip="Снять выделение">
                                <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource MailActionClearSelectionGeometry}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="1.7" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Messages}"
                         Background="White"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Margin="8,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Выбрать письмо"
                                          Command="{Binding DataContext.ToggleMessageSelectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Visibility="{Binding DataContext.IsGmailMailboxAvailable, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Grid.Column="1"
                                         Width="32"
                                         Height="32"
                                         Margin="4,0"
                                         HorizontalAlignment="Center"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="{Binding StarActionText}"
                                         Command="{Binding DataContext.ToggleStarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                         CommandParameter="{Binding}"
                                         FontSize="20"
                                         Style="{StaticResource MailActionToolbarButtonStyle}"
                                         ToolTip="{Binding StarActionText}"
                                         Visibility="{Binding DataContext.IsGmailMailboxAvailable, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="☆" />
                                                <Setter Property="Foreground" Value="#FF6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                                        <Setter Property="Text" Value="★" />
                                                        <Setter Property="Foreground" Value="#FFF4B400" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button x:Name="MessageButton"
                                    Grid.Column="2"
                                    Command="{Binding DataContext.OpenMessageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MailMessageButtonStyle}">
                                <Border x:Name="MessageRow"
                                        MinHeight="46"
                                        Padding="20,7"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" MinWidth="140" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SenderText"
                                                   Margin="0,0,18,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14.5"
                                                   FontWeight="Normal"
                                                   Text="{Binding SenderDisplay}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MaxWidth="320" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SubjectText"
                                                           FontSize="14.5"
                                                           FontWeight="Normal"
                                                           Text="{Binding Subject}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           FontSize="14"
                                                           Foreground="#FF5F6368"
                                                           Text="{Binding Preview, StringFormat=— {0}}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <StackPanel Grid.Row="1"
                                                        Margin="0,6,0,0"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{Binding AttachmentPreviewItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="26"
                                                                    MaxWidth="164"
                                                                    Margin="0,0,5,0"
                                                                    Padding="5,0,8,0"
                                                                    Background="#FFF8FAFC"
                                                                    BorderBrush="#FFD5DAE1"
                                                                    BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    ToolTip="{Binding DisplayFileName}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border x:Name="AttachmentTypeBadge"
                                                                            Width="28"
                                                                            Height="18"
                                                                            VerticalAlignment="Center"
                                                                            Background="#FFE7EBF0"
                                                                            CornerRadius="4">
                                                                        <TextBlock x:Name="AttachmentTypeText"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="8.5"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#FF5F6875"
                                                                                   Text="{Binding TypeLabel}" />
                                                                    </Border>
                                                                    <TextBlock MaxWidth="112"
                                                                               Margin="6,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="12.5"
                                                                               Foreground="#FF3C4043"
                                                                               Text="{Binding DisplayFileName}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding VisualType}" Value="{x:Static models:MailAttachmentVisualType.Pdf}">
                                                                    <Setter TargetName="AttachmentTypeBadge" Property="Background" Value="#FFFCE8E6" />
                                                                    <Setter TargetName="AttachmentTypeText" Property="Foreground" Value="#FFC5221F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding VisualType}" Value="{x:Static models:MailAttachmentVisualType.Image}">
                                                                    <Setter TargetName="AttachmentTypeBadge" Property="Background" Value="#FFE2F4EF" />
                                                                    <Setter TargetName="AttachmentTypeText" Property="Foreground" Value="#FF13795B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding VisualType}" Value="{x:Static models:MailAttachmentVisualType.Document}">
                                                                    <Setter TargetName="AttachmentTypeBadge" Property="Background" Value="#FFE4EEFF" />
                                                                    <Setter TargetName="AttachmentTypeText" Property="Foreground" Value="#FF245BB5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding VisualType}" Value="{x:Static models:MailAttachmentVisualType.Spreadsheet}">
                                                                    <Setter TargetName="AttachmentTypeBadge" Property="Background" Value="#FFE3F3E8" />
                                                                    <Setter TargetName="AttachmentTypeText" Property="Foreground" Value="#FF188038" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding VisualType}" Value="{x:Static models:MailAttachmentVisualType.Archive}">
                                                                    <Setter TargetName="AttachmentTypeBadge" Property="Background" Value="#FFFFEFCB" />
                                                                    <Setter TargetName="AttachmentTypeText" Property="Foreground" Value="#FFA15C00" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding VisualType}" Value="{x:Static models:MailAttachmentVisualType.Text}">
                                                                    <Setter TargetName="AttachmentTypeBadge" Property="Background" Value="#FFE9EEF5" />
                                                                    <Setter TargetName="AttachmentTypeText" Property="Foreground" Value="#FF53657D" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Height="26"
                                                        Padding="8,0"
                                                        Background="#FFE7EEF8"
                                                        BorderBrush="#FFD2DCEB"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Visibility="{Binding HasMoreAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding RemainingAttachmentText}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding DisplayDate}" />
                                    </Grid>
                                </Border>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter TargetName="MessageButton" Property="Background" Value="#FFF2F6FC" />
                                    <Setter TargetName="SenderText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="MessageButton" Property="Background" Value="#FFE7F0FF" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="18,10"
                            HorizontalAlignment="Center">
                    <TextBlock MaxWidth="560"
                               Margin="0,0,0,8"
                               Foreground="#FFB42318"
                               Text="{Binding MailboxActionErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasMailboxActionError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock MaxWidth="560"
                               Margin="0,0,0,8"
                               Foreground="#FFB42318"
                               Text="{Binding ListErrorDescription}"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasListError}" Value="True" />
                                            <Condition Binding="{Binding HasMessages}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock MaxWidth="560"
                               Margin="0,0,0,8"
                               Foreground="#FFB42318"
                               Text="{Binding GmailReauthenticationErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasGmailReauthenticationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,0,8"
                            Command="{Binding ReauthenticateGmailCommand}"
                            Content="Войти в Google"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding RequiresGmailReauthentication, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,0,8"
                            Command="{Binding AuthorizeGmailCommand}"
                            Content="Разрешить управление почтой"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding RequiresGmailAuthorization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Width="180"
                                 Height="3"
                                 Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsListLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Grid Grid.Row="1"
                      Background="White"
                      Visibility="{Binding IsInitialLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Загружаем почту…" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Background="White"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding EmptyListMessage}" />
                </Grid>

                <Grid Grid.Row="1"
                      Background="White"
                      Visibility="{Binding HasBlockingListError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="{Binding ErrorTitle}"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,9,0,16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ListErrorDescription}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,16"
                                   Foreground="#FFB42318"
                                   Text="{Binding GmailReauthenticationErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasGmailReauthenticationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Command="{Binding ReauthenticateGmailCommand}"
                                Content="Войти в Google"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding RequiresGmailReauthentication, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Command="{Binding RetryCommand}"
                                Content="Повторить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding ShowTransientRetryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="MessageDetailSurface"
                  Grid.Row="1"
                  Background="White"
                  Visibility="{Binding IsMessageDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="18,0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button HorizontalAlignment="Left"
                                AutomationProperties.Name="Назад к списку"
                                Command="{Binding BackToMessageListCommand}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Назад к списку">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20,12 L5,12 M11,6 L5,12 L11,18"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="Архивировать"
                                Command="{Binding ArchiveDetailCommand}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Архивировать"
                                Visibility="{Binding IsGmailMailboxAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource MailActionArchiveGeometry}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeThickness="1.6" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="Удалить"
                                Command="{Binding DeleteDetailCommand}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Удалить"
                                Visibility="{Binding IsGmailMailboxAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource MailActionTrashGeometry}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeThickness="1.6" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="{Binding DetailStarActionText}"
                                Command="{Binding ToggleStarCommand}"
                                CommandParameter="{Binding SelectedMessageSummary}"
                                FontSize="20"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="{Binding DetailStarActionText}"
                                Visibility="{Binding IsGmailMailboxAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="☆" />
                                        <Setter Property="Foreground" Value="#FF6B7280" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMessageSummary.IsStarred}" Value="True">
                                                <Setter Property="Text" Value="★" />
                                                <Setter Property="Foreground" Value="#FFF4B400" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="Ярлыки"
                                Command="{Binding OpenLabelsForDetailCommand}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Ярлыки"
                                Visibility="{Binding IsGmailMailboxAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource MailActionLabelGeometry}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="{Binding ReadStateActionText}"
                                Command="{Binding SetReadStateCommand}"
                                IsEnabled="{Binding CanChangeReadState}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="{Binding ReadStateActionText}"
                                Visibility="{Binding ShowReadStateAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.65">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource MailActionMarkUnreadGeometry}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMessageSummary.IsUnread}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource MailActionMarkReadGeometry}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="Ответить"
                                Command="{Binding Compose.ReplyCommand}"
                                CommandParameter="{Binding SelectedMessageContent}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Ответить">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M10,6.5 L4,12 L10,17.5 M5,12 L13,12 C17.5,12 20,14.5 20,19"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="Ответить всем"
                                Command="{Binding Compose.ReplyAllCommand}"
                                CommandParameter="{Binding SelectedMessageContent}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Ответить всем"
                                Visibility="{Binding Compose.IsReplyAllAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M10,6.5 L4,12 L10,17.5 M5,12 L13,12 C17.5,12 20,14.5 20,19 M14,6.5 L11,9.5 M14,17.5 L11,14.5"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="Переслать"
                                Command="{Binding Compose.ForwardCommand}"
                                CommandParameter="{Binding SelectedMessageContent}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Переслать">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M14,6.5 L20,12 L14,17.5 M19,12 L11,12 C6.5,12 4,14.5 4,19"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Margin="4,0,0,0"
                                AutomationProperties.Name="Распечатать письмо"
                                Click="Print_Click"
                                IsEnabled="{Binding CanPrintMessage}"
                                Style="{StaticResource MailDetailToolbarButtonStyle}"
                                ToolTip="Распечатать письмо"
                                Visibility="{Binding ShowPrintAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Style="{StaticResource MailToolbarIconViewboxStyle}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6.5,9 L6.5,4 L17.5,4 L17.5,9 M6.5,17 L4,17 L4,10 L20,10 L20,17 L17.5,17 M6.5,14.5 L17.5,14.5 L17.5,21 L6.5,21 Z M17,12 L18,12"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Padding="28,20,28,16"
                        Background="White"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding HasSelectedContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   LineHeight="31"
                                   Text="{Binding SelectedMessageContent.Subject}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedMessageContent.SenderDisplay}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding SelectedMessageContent.FromAddress}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding SelectedMessageContent.To, StringFormat=Кому: {0}}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="18,1,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding SelectedMessageDisplayDate}" />
                        </Grid>

                        <StackPanel Margin="0,13,0,0"
                                    Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,7"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="Вложения" />
                            <ItemsControl ItemsSource="{Binding SelectedMessageContent.Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="10,7"
                                                Background="#FFF5F7FA"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding DisplaySize, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding ContentType, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Сохранить"
                                                        Style="{StaticResource MailSecondaryButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding AttachmentStatusMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasAttachmentStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Margin="0,13,0,0">
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding RequiresGmailAuthorization, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock MaxWidth="620"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding ReadStateAuthorizationText}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AuthorizeGmailCommand}"
                                        Content="Разрешить"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#FFB42318"
                                       Text="{Binding ReadStateErrorMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasReadStateError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#FFB42318"
                                       Text="{Binding MailboxActionErrorMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasMailboxActionError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ReauthenticateGmailCommand}"
                                    Content="Войти в Google"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding RequiresGmailReauthentication, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ReauthenticateGmailCommand}"
                                    Content="Войти в Google"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding RequiresGmailReadStateReauthentication, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Padding="18,10"
                        Background="#FFFFF4CE"
                        BorderBrush="#FFE6C45C"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowRemoteImagesBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#FF5C4800"
                                   Text="{Binding RemoteImagesBannerText}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button x:Name="ShowRemoteImagesButton"
                                    Margin="0,0,8,4"
                                    Padding="18,8"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="ShowRemoteImages_Click"
                                    Content="{Binding RemoteImagesButtonText}"
                                    IsEnabled="{Binding CanShowRemoteImages}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding ShowOneTimeRemoteImagesAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,0,8,4"
                                    Padding="14,8"
                                    Click="AlwaysShowRemoteImagesFromSender_Click"
                                    Content="Всегда показывать от этого отправителя"
                                    IsEnabled="{Binding CanAlwaysShowRemoteImagesFromSender}"
                                    Style="{StaticResource MailSecondaryButtonStyle}"
                                    Visibility="{Binding ShowAlwaysRemoteImagesFromSenderAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,0,8,4"
                                    Padding="14,8"
                                    Click="RevokeRemoteImagesFromSender_Click"
                                    Content="Не показывать автоматически от этого отправителя"
                                    Style="{StaticResource MailSecondaryButtonStyle}"
                                    Visibility="{Binding ShowRevokeRemoteImagesFromSenderAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Background="White">
                    <TextBox Padding="28,24,28,40"
                             AcceptsReturn="True"
                             Background="White"
                             BorderThickness="0"
                             FontFamily="Segoe UI"
                             FontSize="15"
                             IsReadOnly="True"
                             Text="{Binding SelectedMessageContent.PlainTextContent, Mode=OneWay}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsSelectedMessagePlainText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border x:Name="MailHtmlRendererSurface"
                            Background="White"
                            Visibility="{Binding ShouldDisplayHtmlRenderer, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsMessageLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Загружаем письмо…" />
                    </StackPanel>

                    <StackPanel MaxWidth="380"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasMessageError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Не удалось открыть письмо"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,9,0,16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding MessageErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,16"
                                   Foreground="#FFB42318"
                                   Text="{Binding GmailReauthenticationErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasGmailReauthenticationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Command="{Binding ReauthenticateGmailCommand}"
                                Content="Войти в Google"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding RequiresGmailMessageReauthentication, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Command="{Binding RetryMessageCommand}"
                                Content="Повторить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding ShowMessageRetryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="ComposeSurface"
                  Grid.Row="1"
                  Margin="28,22"
                  IsEnabled="{Binding Compose.CanEdit}"
                  IsVisibleChanged="ComposeSurface_IsVisibleChanged"
                  Visibility="{Binding Compose.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border MaxWidth="940"
                        Padding="30"
                        HorizontalAlignment="Stretch"
                        Background="White"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="3"
                                   Margin="0,0,0,18"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="Новое письмо" />

                        <TextBlock Grid.Row="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="От:" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 Padding="10,7"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 Text="{Binding Compose.FromAddress, Mode=OneWay}" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,12,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Кому:" />
                        <TextBox x:Name="ComposeToTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,12,0,0"
                                 Padding="10,7"
                                 TabIndex="1"
                                 Text="{Binding Compose.Draft.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Margin="10,12,0,0"
                                Command="{Binding Compose.RevealCopyFieldsCommand}"
                                Content="Копия / Скрытая"
                                IsTabStop="False"
                                Style="{StaticResource MailSecondaryButtonStyle}" />

                        <Grid Grid.Row="3"
                              Grid.ColumnSpan="3"
                              Margin="0,10,0,0"
                              Visibility="{Binding Compose.Draft.AreCopyFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Копия:" />
                            <TextBox Grid.Column="1"
                                     Padding="10,7"
                                     TabIndex="2"
                                     Text="{Binding Compose.Draft.Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Скрытая:" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,8,0,0"
                                     Padding="10,7"
                                     TabIndex="3"
                                     Text="{Binding Compose.Draft.Bcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="4"
                              Grid.ColumnSpan="3"
                              Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ComposeSubjectTextBox"
                                     Padding="10,8"
                                     TabIndex="4"
                                     Text="{Binding Compose.Draft.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Тема" />
                            <TextBox x:Name="ComposeBodyTextBox"
                                     Grid.Row="1"
                                     MinHeight="230"
                                     Margin="0,12,0,0"
                                     Padding="12"
                                     AcceptsReturn="True"
                                     AcceptsTab="False"
                                     SpellCheck.IsEnabled="True"
                                     TabIndex="5"
                                     Text="{Binding Compose.Draft.TextBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding Compose.AttachFilesCommand}"
                                        Content="Прикрепить файл"
                                        Style="{StaticResource MailSecondaryButtonStyle}" />
                                <ScrollViewer MaxHeight="130"
                                              Margin="0,8,0,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Compose.Draft.Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6"
                                                        Padding="10,7"
                                                        Background="#FFF5F7FA"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Visibility="{Binding IsForwardedSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="📎 " />
                                                            <Run Text="{Binding FileName, Mode=OneWay}" />
                                                            <Run Text="  " />
                                                            <Run Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DisplaySize, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Button Grid.Column="2"
                                                                Width="30"
                                                                Height="30"
                                                                Margin="10,0,0,0"
                                                                Command="{Binding DataContext.Compose.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="×"
                                                                ToolTip="Удалить вложение" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="5"
                                   Grid.ColumnSpan="3"
                                   Margin="0,12,0,0"
                                   Foreground="#FFB42318"
                                   Text="{Binding Compose.ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Compose.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Grid.Row="6"
                                    Grid.ColumnSpan="2"
                                    Margin="0,18,16,0"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding RequiresGmailComposeReauthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#FFB42318"
                                       Text="{Binding GmailReauthenticationErrorMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasGmailReauthenticationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ReauthenticateGmailCommand}"
                                    Content="Войти в Google"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="6"
                                    Grid.ColumnSpan="3"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,10,0"
                                    Command="{Binding Compose.CancelCommand}"
                                    Content="Отмена"
                                    Style="{StaticResource MailSecondaryButtonStyle}" />
                            <Button Command="{Binding Compose.SendCommand}"
                                    Content="{Binding Compose.SendButtonText}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    TabIndex="6" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Panel.ZIndex="100"
                    Width="320"
                    MaxHeight="420"
                    Margin="56,48,0,0"
                    Padding="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="White"
                    BorderBrush="#FFD5DAE1"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsLabelMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="3" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding LabelMenuTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="300"
                                  Margin="0,10,0,10"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UserLabels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,1"
                                            Padding="8,6"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.ToggleUserLabelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsApplied, Mode=OneWay}"
                                                      IsHitTestVisible="False"
                                                      IsThreeState="True" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1"
                               Margin="0,12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Пользовательских ярлыков нет.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUserLabels}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Row="2"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseLabelsCommand}"
                            Content="Готово"
                            Style="{StaticResource MailSecondaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
