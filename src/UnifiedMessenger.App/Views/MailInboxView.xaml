<UserControl x:Class="UnifiedMessenger.App.Views.MailInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Входящие" />
                        <Border Margin="10,0,0,0"
                                Padding="8,2"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="8">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding ProviderDisplayName}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding EmailAddress}" />
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" MinWidth="340" MaxWidth="430" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Messages}"
                         SelectedItem="{Binding SelectedMessageSummary, Mode=TwoWay}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,13"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="SenderText"
                                               Margin="0,0,10,0"
                                               FontWeight="Normal"
                                               Text="{Binding SenderDisplay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding DisplayDate}" />
                                    <TextBlock x:Name="SubjectText"
                                               Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,5,0,0"
                                               FontWeight="Normal"
                                               Text="{Binding Subject}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               MaxHeight="36"
                                               Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter TargetName="SenderText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1"
                            Margin="14,10"
                            HorizontalAlignment="Center">
                    <TextBlock MaxWidth="340"
                               Margin="0,0,0,8"
                               Foreground="#FFB42318"
                               Text="{Binding ListErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasListError}" Value="True" />
                                            <Condition Binding="{Binding HasMessages}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Command="{Binding LoadMoreCommand}"
                            Content="Загрузить ещё"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Width="180"
                                 Height="3"
                                 Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsListLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Grid Grid.RowSpan="2"
                      Background="{DynamicResource SurfaceBrush}"
                      Visibility="{Binding IsInitialLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="200" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,16,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Загружаем почту…" />
                    </StackPanel>
                </Grid>

                <Grid Grid.RowSpan="2"
                      Background="{DynamicResource SurfaceBrush}"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Во входящих пока нет писем." />
                </Grid>

                <Grid Grid.RowSpan="2"
                      Background="{DynamicResource SurfaceBrush}"
                      Visibility="{Binding HasBlockingListError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="{Binding ErrorTitle}"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,10,0,18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ListErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Center"
                                Command="{Binding RetryCommand}"
                                Content="Повторить"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

            <Grid Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}">
                <Grid Visibility="{Binding HasSelectedContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="30,24,30,20"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       LineHeight="32"
                                       Text="{Binding SelectedMessageContent.Subject}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedMessageContent.SenderDisplay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedMessageContent.FromAddress}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding EmailAddress, StringFormat=кому: {0}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="18,1,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding SelectedMessageContent.ReceivedAtLocal, StringFormat={}{0:G}}" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="В письме есть вложения. Загрузка вложений появится в следующем этапе."
                                       Visibility="{Binding SelectedMessageContent.HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1"
                            Padding="18,10"
                            Background="#FFFFF4CE"
                            BorderBrush="#FFE6C45C"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding ShowRemoteImagesBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#FF5C4800"
                                       Text="Внешние изображения заблокированы для защиты конфиденциальности."
                                       TextWrapping="Wrap" />
                            <Button x:Name="ShowRemoteImagesButton"
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Padding="18,8"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="ShowRemoteImages_Click"
                                    Content="{Binding RemoteImagesButtonText}"
                                    IsEnabled="{Binding CanShowRemoteImages}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Background="White">
                        <TextBox Padding="30,26,30,44"
                                 AcceptsReturn="True"
                                 Background="White"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI"
                                 FontSize="15"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedMessageContent.PlainTextContent, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsSelectedMessagePlainText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border x:Name="MailHtmlRendererSurface"
                                Background="White"
                                Visibility="{Binding IsSelectedMessageHtml, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowMessagePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Выберите письмо" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Содержимое откроется здесь в безопасном режиме." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsMessageLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="200" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,16,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Загружаем письмо…" />
                </StackPanel>

                <StackPanel MaxWidth="380"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasMessageError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Text="Не удалось открыть письмо"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,10,0,18"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding MessageErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Center"
                            Command="{Binding RetryMessageCommand}"
                            Content="Повторить"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
