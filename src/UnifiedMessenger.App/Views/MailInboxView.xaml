<UserControl x:Class="UnifiedMessenger.App.Views.MailInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedFolder.DisplayName, TargetNullValue=Почта}" />
                        <Border Margin="10,0,0,0"
                                Padding="8,2"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="8">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding ProviderDisplayName}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding EmailAddress}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Foreground="#FF237A3B"
                               Text="{Binding Compose.StatusMessage}"
                               Visibility="{Binding Compose.HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,10,0"
                            Command="{Binding Compose.NewMessageCommand}"
                            Content="Написать"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Command="{Binding RefreshCommand}"
                            Content="Обновить"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Visibility="{Binding Compose.IsClosed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" MinWidth="130" MaxWidth="170" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="360" MinWidth="300" MaxWidth="410" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Padding="8,12"
                     ItemsSource="{Binding Folders}"
                     SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Padding="10,9"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Messages}"
                         SelectedItem="{Binding SelectedMessageSummary, Mode=TwoWay}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,13"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="SenderText"
                                               Margin="0,0,10,0"
                                               FontWeight="Normal"
                                               Text="{Binding SenderDisplay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding DisplayDate}" />
                                    <TextBlock x:Name="SubjectText"
                                               Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,5,0,0"
                                               FontWeight="Normal"
                                               Text="{Binding Subject}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               MaxHeight="36"
                                               Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter TargetName="SenderText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1"
                            Margin="14,10"
                            HorizontalAlignment="Center">
                    <TextBlock MaxWidth="340"
                               Margin="0,0,0,8"
                               Foreground="#FFB42318"
                               Text="{Binding ListErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasListError}" Value="True" />
                                            <Condition Binding="{Binding HasMessages}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Command="{Binding LoadMoreCommand}"
                            Content="Загрузить ещё"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Width="180"
                                 Height="3"
                                 Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsListLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Grid Grid.RowSpan="2"
                      Background="{DynamicResource SurfaceBrush}"
                      Visibility="{Binding IsInitialLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="200" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,16,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Загружаем почту…" />
                    </StackPanel>
                </Grid>

                <Grid Grid.RowSpan="2"
                      Background="{DynamicResource SurfaceBrush}"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="В этой папке пока нет писем." />
                </Grid>

                <Grid Grid.RowSpan="2"
                      Background="{DynamicResource SurfaceBrush}"
                      Visibility="{Binding HasBlockingListError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="{Binding ErrorTitle}"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,10,0,18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ListErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Center"
                                Command="{Binding RetryCommand}"
                                Content="Повторить"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" />

            <Grid Grid.Column="4" Background="{DynamicResource WindowBackgroundBrush}">
                <Grid Visibility="{Binding HasSelectedContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="30,24,30,20"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       LineHeight="32"
                                       Text="{Binding SelectedMessageContent.Subject}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedMessageContent.SenderDisplay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedMessageContent.FromAddress}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding EmailAddress, StringFormat=кому: {0}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="18,1,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding SelectedMessageContent.ReceivedAtLocal, StringFormat={}{0:G}}" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="В письме есть вложения. Загрузка вложений появится в следующем этапе."
                                       Visibility="{Binding SelectedMessageContent.HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Padding="14,7"
                                            Command="{Binding Compose.ReplyCommand}"
                                            CommandParameter="{Binding SelectedMessageContent}"
                                            Content="Ответить"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Margin="0,0,8,0"
                                            Padding="14,7"
                                            Command="{Binding Compose.ForwardCommand}"
                                            CommandParameter="{Binding SelectedMessageContent}"
                                            Content="Переслать"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Padding="14,7"
                                            Command="{Binding SetReadStateCommand}"
                                            Content="{Binding ReadStateActionText}"
                                            IsEnabled="{Binding CanChangeReadState}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding ShowReadStateAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding RequiresGmailAuthorization, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock MaxWidth="520"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding ReadStateAuthorizationText}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="14,7"
                                            Command="{Binding AuthorizeGmailCommand}"
                                            Content="Разрешить"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#FFB42318"
                                           Text="{Binding ReadStateErrorMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasReadStateError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1"
                            Padding="18,10"
                            Background="#FFFFF4CE"
                            BorderBrush="#FFE6C45C"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding ShowRemoteImagesBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#FF5C4800"
                                       Text="Внешние изображения заблокированы для защиты конфиденциальности."
                                       TextWrapping="Wrap" />
                            <Button x:Name="ShowRemoteImagesButton"
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Padding="18,8"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="ShowRemoteImages_Click"
                                    Content="{Binding RemoteImagesButtonText}"
                                    IsEnabled="{Binding CanShowRemoteImages}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Background="White">
                        <TextBox Padding="30,26,30,44"
                                 AcceptsReturn="True"
                                 Background="White"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI"
                                 FontSize="15"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedMessageContent.PlainTextContent, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsSelectedMessagePlainText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border x:Name="MailHtmlRendererSurface"
                                Background="White"
                                Visibility="{Binding IsSelectedMessageHtml, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowMessagePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Выберите письмо" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Содержимое откроется здесь в безопасном режиме." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsMessageLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="200" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,16,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Загружаем письмо…" />
                </StackPanel>

                <StackPanel MaxWidth="380"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasMessageError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Text="Не удалось открыть письмо"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,10,0,18"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding MessageErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Center"
                            Command="{Binding RetryMessageCommand}"
                            Content="Повторить"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="ComposeSurface"
              Grid.Row="1"
              Margin="34,26"
              IsEnabled="{Binding Compose.CanEdit}"
              IsVisibleChanged="ComposeSurface_IsVisibleChanged"
              Visibility="{Binding Compose.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="980"
                    Padding="30"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="3"
                               Margin="0,0,0,18"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="Новое письмо" />

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="От:" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Padding="10,7"
                              IsReadOnly="True"
                              IsTabStop="False"
                              Text="{Binding Compose.FromAddress, Mode=OneWay}" />

                    <TextBlock Grid.Row="2"
                               Margin="0,12,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Кому:" />
                    <TextBox x:Name="ComposeToTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,12,0,0"
                             Padding="10,7"
                             TabIndex="1"
                             Text="{Binding Compose.Draft.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Margin="10,12,0,0"
                            Padding="12,7"
                            Command="{Binding Compose.RevealCopyFieldsCommand}"
                            IsTabStop="False"
                            Content="Копия / Скрытая"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Grid Grid.Row="3"
                          Grid.ColumnSpan="3"
                          Margin="0,10,0,0"
                          Visibility="{Binding Compose.Draft.AreCopyFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Копия:" />
                        <TextBox Grid.Column="1"
                                 Padding="10,7"
                                 TabIndex="2"
                                 Text="{Binding Compose.Draft.Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Скрытая:" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,8,0,0"
                                 Padding="10,7"
                                 TabIndex="3"
                                 Text="{Binding Compose.Draft.Bcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="4"
                          Grid.ColumnSpan="3"
                          Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ComposeSubjectTextBox"
                                 Padding="10,8"
                                 TabIndex="4"
                                 Text="{Binding Compose.Draft.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Тема" />
                        <TextBox x:Name="ComposeBodyTextBox"
                                 Grid.Row="1"
                                 MinHeight="250"
                                 Margin="0,12,0,0"
                                 Padding="12"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 SpellCheck.IsEnabled="True"
                                 TabIndex="5"
                                 Text="{Binding Compose.Draft.TextBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <TextBlock Grid.Row="5"
                               Grid.ColumnSpan="3"
                               Margin="0,12,0,0"
                               Foreground="#FFB42318"
                               Text="{Binding Compose.ErrorMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Compose.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Row="6"
                                Grid.ColumnSpan="3"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,10,0"
                                Padding="18,9"
                                Command="{Binding Compose.CancelCommand}"
                                Content="Отмена" />
                        <Button Padding="20,9"
                                Command="{Binding Compose.SendCommand}"
                                Content="{Binding Compose.SendButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                TabIndex="6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
