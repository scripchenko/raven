<Window x:Class="UnifiedMessenger.App.Views.WebViewRuntimeRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Требуется WebView2 Runtime"
        Width="480"
        Height="260"
        MinWidth="480"
        MinHeight="260"
        MaxWidth="480"
        MaxHeight="260"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="21"
                       FontWeight="SemiBold"
                       Text="Для работы приложения требуется Microsoft Edge WebView2 Runtime."
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Откройте официальную страницу Microsoft, установите Evergreen Runtime и снова запустите Lantern."
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="108"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="OnCloseClicked"
                    Content="Закрыть" />
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnInstallClicked"
                    Content="Установить" />
        </StackPanel>
    </Grid>
</Window>
