<Window x:Class="UnifiedMessenger.App.Views.WebViewRuntimeRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:UnifiedMessenger.App.Services.Localization"
        Title="{loc:Text Key='WebView2 Runtime required'}"
        Width="480"
        Height="260"
        MinWidth="480"
        MinHeight="260"
        MaxWidth="480"
        MaxHeight="260"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="21"
                       FontWeight="SemiBold"
                       Text="{loc:Text Key='Microsoft Edge WebView2 Runtime is required to run this application.'}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{loc:Text Key='Open the official Microsoft page, install Evergreen Runtime, and restart raven.'}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="108"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="OnCloseClicked"
                    Content="{loc:Text Key='Close'}" />
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnInstallClicked"
                    Content="{loc:Text Key='Install'}" />
        </StackPanel>
    </Grid>
</Window>
