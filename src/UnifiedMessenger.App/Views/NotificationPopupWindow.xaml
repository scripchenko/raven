<Window x:Class="UnifiedMessenger.App.Views.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="363"
        MinHeight="92"
        MaxHeight="240"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DrawingImage x:Key="MailNotificationIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFEAF2FF" Geometry="M2,5 L30,5 30,27 2,27 Z" />
                    <GeometryDrawing Geometry="M2,5 L30,5 30,27 2,27 Z M2,5 L16,17 30,5">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF2356B8" Thickness="2" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="PopupSourceIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/UnifiedMessenger.App;component/Assets/Branding/raven_icon.png" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ServiceName}" Value="Telegram">
                    <Setter Property="Source" Value="/UnifiedMessenger.App;component/Assets/Services/telegram.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServiceName}" Value="WhatsApp">
                    <Setter Property="Source" Value="/UnifiedMessenger.App;component/Assets/Services/whatsapp.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServiceName}" Value="MAX">
                    <Setter Property="Source" Value="/UnifiedMessenger.App;component/Assets/Services/max.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServiceName}" Value="Почта">
                    <Setter Property="Source" Value="{StaticResource MailNotificationIcon}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGmail}" Value="True">
                    <Setter Property="Source" Value="/UnifiedMessenger.App;component/Assets/Services/gmail.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsYandex}" Value="True">
                    <Setter Property="Source" Value="/UnifiedMessenger.App;component/Assets/Services/yandex_mail.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMailRu}" Value="True">
                    <Setter Property="Source" Value="/UnifiedMessenger.App;component/Assets/Services/mailru.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupContentSourceIconStyle"
               TargetType="Image"
               BasedOn="{StaticResource PopupSourceIconStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowSenderInitials}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF404040" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonBackground" Property="Background" Value="#FFE8E8E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseButtonBackground" Property="Background" Value="#FFDCDCDC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The four-DIP shadow inset leaves a 355 x 84 DIP compact visible card. -->
    <Border x:Name="PopupCard"
            Margin="4"
            MinHeight="84"
            Padding="14,10"
            Background="#FFFAFAFA"
            BorderBrush="#FFD9D9D9"
            BorderThickness="1"
            CornerRadius="2"
            MouseLeftButtonUp="Popup_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" Opacity="0.18" ShadowDepth="1" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderSourceIcon"
                       Width="20"
                       Height="20"
                       Style="{StaticResource PopupSourceIconStyle}" />
                <TextBlock x:Name="SourceLabel"
                           Grid.Column="1"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="#FF505050"
                           Text="{Binding ServiceName}" />
                <TextBlock Grid.Column="2"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#FF858585"
                           Text="• сейчас" />
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        Width="26"
                        Height="26"
                        Margin="0,-3,-4,-3"
                        Style="{StaticResource PopupCloseButtonStyle}"
                        Content="×"
                        Focusable="False"
                        FontSize="18"
                        ToolTip="Закрыть"
                        AutomationProperties.Name="Закрыть уведомление"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="NotificationText" Margin="0,0,12,0">
                    <!-- Visual offsets preserve the measured card and source-icon geometry. -->
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="-3" />
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="NotificationTitle"
                               Margin="0,0,0,1"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF202020"
                               Text="{Binding Title}"
                               MaxHeight="54"
                               LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="NotificationBody"
                               MaxHeight="{Binding PreviewMaxHeight}"
                               FontSize="12.5"
                               Foreground="#FF454545"
                               Text="{Binding Body}"
                               LineHeight="16"
                               LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NotificationPreview"
                               Margin="0,1,0,0"
                               MaxHeight="48"
                               FontSize="12"
                               Foreground="#FF777777"
                               Text="{Binding PreviewText}"
                               LineHeight="15"
                               LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasPreviewText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <Grid Grid.Column="1"
                      Width="36"
                      Height="36"
                      VerticalAlignment="Top">
                    <Image x:Name="ContentSourceIcon"
                           Width="36"
                           Height="36"
                           Style="{StaticResource PopupContentSourceIconStyle}" />
                    <Border x:Name="SenderInitialsAvatar"
                            Width="36"
                            Height="36"
                            Background="{Binding SenderAvatarBackground}"
                            CornerRadius="18"
                            Visibility="{Binding ShowSenderInitials, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding SenderAvatarInitials}" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
